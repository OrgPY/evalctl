{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/evalctl/hooks/evalctl_prompt_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/evalctl/hooks/evalctl_stop_hook.py\"",
            "timeout": 600,
            "statusMessage": "evalctl: verifying receipt"
          }
        ]
      }
    ]
  }
}
